# Copy to ../.env or backend/.env — see root .env.example
DJANGO_SECRET_KEY=dev-resumematch-secret-key-not-for-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,*
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:43124,http://127.0.0.1:43124
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-20250514
# Application emails only. Leave DEEPSEEK_API_KEY empty to keep the local draft.
DEEPSEEK_API_KEY=
DEEPSEEK_USER_ID=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
