# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (leave empty for SQLite; set for PostgreSQL)
DATABASE_URL=
# Or individual PostgreSQL settings:
# POSTGRES_DB=resumematch
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# CORS (comma-separated frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# JWT
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# LLM — interview questions, interview grading, and application emails
# Leave LLM_API_KEY empty to use deterministic mock mode
# LLM_PROVIDER: anthropic | openai | gemini  (gemini: LLM_MODEL=gemini-3.8-flash)
# LLM_BASE_URL: only for an OpenAI-compatible endpoint
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-20250514
LLM_BASE_URL=
LLM_MAX_RETRIES=3

# Application emails only. Leave empty to keep the local email draft.
DEEPSEEK_API_KEY=
DEEPSEEK_USER_ID=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Limits: AI endpoints per user (DRF rate syntax) and analyses per rolling 24h (0 = unlimited)
AI_THROTTLE_RATE=30/hour
JOB_IMPORT_THROTTLE_RATE=20/hour
ANALYSIS_DAILY_QUOTA=20

# Job search ("Trouver des offres"): free public feeds, comma-separated (remotive, arbeitnow, jobicy)
JOB_SEARCH_SOURCES=remotive,arbeitnow,jobicy
# Optional keyed sources for French offers, enabled automatically when credentials are set
# Adzuna: https://developer.adzuna.com  ·  France Travail: https://francetravail.io (API Offres d'emploi v2)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=fr
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# Score weights (must sum to ~1.0)
SCORE_WEIGHT_SKILLS=0.55
SCORE_WEIGHT_SEMANTIC=0.45
# Level overrides for experience emphasis (semantic weight multiplier)
SCORE_LEVEL_ETUDIANT_SEMANTIC=0.7
SCORE_LEVEL_JUNIOR_SEMANTIC=1.0
SCORE_LEVEL_CONFIRME_SEMANTIC=1.2
